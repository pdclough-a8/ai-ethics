---
import Layout from '../layouts/Layout.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import { withBase } from '../scripts/paths';
import { bonusPages } from '../scripts/bonusPages';

// Real copy, from course/en/course.json's title/body/_menu fields (the
// course "home" page Adapt renders separately from the 7 topic pages) -
// plus one added paragraph (see below) that isn't part of that original text.
const introBody = `<p>AI systems are transforming how we work, communicate and make decisions. As these technologies become more powerful and pervasive, the question of how to use, develop and deploy them ethically and responsibly has never been more important.</p><p>In this course, you'll explore the foundations of AI ethics, follow the AI lifecycle to see where ethical considerations apply in practice, and examine real-world case studies where things went wrong - and why.</p><p>Not everyone taking this course is building an AI system - many people are using tools, like Copilot or Claude, that someone else already built, or overseeing how AI is used across an organisation. Every stage still applies either way, but what "applying" it means is different: if you're building, you're the one making each decision directly; if you're using or overseeing a tool someone else built, it means knowing enough about each stage to judge the tool's answers, question how it was built, and recognise when something's off - not making that decision yourself.</p><p>This content was written and curated by Paul Clough, Lead Data Science and AI Consultant at Analytics8 and Professor Emeritus at the University of Sheffield.</p><p><strong>Select 'Introduction' to begin.</strong></p>`;

// Reconciles the two navigation models this course previously mixed (the
// hero copy's "select Introduction to begin", implying a sequence, against
// this grid's old "click any block" framing, implying a free-for-all): the
// AI lifecycle stages genuinely do build on each other, so order is
// suggested via numbering + this instruction, but every tile stays a plain
// link - nothing here gates navigation, and progress (via tracking.ts) lets
// a returning visitor jump straight back to where they left off.
const menuInstructionText =
  "Best worked through in order, but not mandatory - jump ahead, or pick up right where you left off.";

const pages = [
  { title: 'Introduction', href: '/introduction/' },
  { title: 'AI Ethics: The Foundations', href: '/foundations/' },
  { title: 'Business Understanding', href: '/business-understanding/' },
  { title: 'Data Acquisition & Understanding', href: '/data-acquisition/' },
  { title: 'Modeling', href: '/modeling/' },
  { title: 'Deployment & Beyond', href: '/deployment-beyond/' },
  { title: 'Conclusion', href: '/conclusion/' },
];

---

<Layout title="AI Ethics and Responsible AI" variant="landing">
  <section class="a8-hero">
    <div class="a8-container a8-hero__inner">
      <div class="a8-hero__text">
        <h1>AI Ethics and Responsible AI</h1>
        <div class="a8-prose" set:html={introBody} />
      </div>
      <div class="a8-hero__image">
        <HeroGraphic />
      </div>
    </div>
  </section>

  <section class="a8-menu a8-container">
    <p class="a8-menu__instruction">{menuInstructionText}</p>
    <div class="a8-menu__grid">
      {pages.map((p, i) => (
        <a href={withBase(p.href)} class="a8-menu__tile" data-menu-tile>
          <span class="a8-menu__tile-top">
            <span class="a8-menu__tile-number">{i + 1}</span>
            <span class="a8-menu__tile-check" aria-hidden="true">✓</span>
          </span>
          <span class="a8-menu__tile-title">{p.title}</span>
          <span class="a8-menu__tile-continue" data-continue-badge hidden>Continue here</span>
        </a>
      ))}
    </div>

    {bonusPages.length > 0 && (
      <div class="a8-menu__bonus">
        <h2 class="a8-menu__bonus-heading">Take it further</h2>
        <p class="a8-menu__instruction">
          Come back here once you've finished the seven stages above - each of these applies what you've just
          learned to a specific situation: a tool your organisation actually uses, or turning principles into
          organisational practice. (You'll also find a link here again at the end of the Conclusion page.)
        </p>
        <div class="a8-menu__grid">
          {bonusPages.map((p) => (
            <a href={withBase(p.href)} class="a8-menu__tile a8-menu__tile--bonus" data-menu-tile>
              <span class="a8-menu__tile-top">
                <span class="a8-menu__tile-check" aria-hidden="true">✓</span>
              </span>
              <span class="a8-menu__tile-title">{p.title}</span>
              <span class="a8-menu__tile-continue" data-continue-badge hidden>Continue here</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  // Marks each tile as visited/not, and flags the first not-yet-visited
  // stage as "Continue here" for a returning visitor - but only once
  // there's some progress to resume; a brand-new visitor already has the
  // hero copy's "select Introduction to begin" and doesn't need a second,
  // possibly-redundant prompt pointing at the same tile.
  import { getVisitedPages, normalisePath } from '../scripts/tracking';

  // Layout.astro records every page visit under this same key - including
  // the home page's own path, the moment someone lands here. So "has this
  // visitor made any course progress" can't just be "is the visited list
  // non-empty" (that's true immediately, for everyone) - it has to check
  // specifically against the course-page tiles below (the 7 lifecycle
  // stages, plus any bonus tool-specific tiles - this selector and the
  // logic below don't care which section a tile came from).
  const visited = new Set(getVisitedPages());
  const tiles = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-menu-tile]'));
  const tileStates = tiles.map((tile) => ({
    tile,
    path: normalisePath(new URL(tile.href).pathname),
  }));
  const hasCourseProgress = tileStates.some(({ path }) => visited.has(path));

  let continueAssigned = false;
  tileStates.forEach(({ tile, path }) => {
    if (visited.has(path)) {
      tile.setAttribute('data-visited', 'true');
    } else if (hasCourseProgress && !continueAssigned) {
      tile.setAttribute('data-continue', 'true');
      const badge = tile.querySelector<HTMLElement>('[data-continue-badge]');
      if (badge) badge.hidden = false;
      continueAssigned = true;
    }
  });
</script>

<style>
  /* Solid dark backdrop behind the text - no image sits behind the copy,
     so contrast stays reliable regardless of what the illustration looks
     like. The illustration itself sits in its own column to the side. */
  .a8-hero {
    background: var(--a8-ink);
    color: #fff;
  }
  .a8-hero__inner {
    display: flex;
    align-items: center;
    gap: var(--a8-space-lg);
    padding-top: var(--a8-space-lg);
    padding-bottom: var(--a8-space-lg);
  }
  .a8-hero__text {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .a8-hero__image {
    flex: 1 1 16rem;
    max-width: 22rem;
  }
  @media (max-width: 640px) {
    .a8-hero__image {
      display: none;
    }
  }
  .a8-hero h1 {
    color: #fff;
    font-size: 2rem;
    border-bottom: 1px solid #fff;
    padding-bottom: var(--a8-space-sm);
    margin-bottom: var(--a8-space-md);
  }
  .a8-hero .a8-prose :global(p) {
    margin: 0 0 var(--a8-space-md);
  }
  .a8-menu {
    padding-top: var(--a8-space-lg);
    padding-bottom: var(--a8-space-lg);
  }
  .a8-menu__instruction {
    color: var(--a8-text-muted);
    font-size: 0.9rem;
  }
  .a8-menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--a8-space-md);
  }
  /* Dark navy + white, not the shared orange accent - this course's
     original had a deliberate custom.css override for its box-menu tiles
     (rgb(15,35,65) at 80% opacity, white text), so carried over here
     rather than defaulting to the same tile styling as Data Ethics. */
  .a8-menu__tile {
    position: relative;
    background: #0f2341;
    color: #ffffff;
    font-family: var(--a8-font-heading);
    text-decoration: none;
    border-radius: var(--a8-radius);
    padding: var(--a8-space-md);
    min-height: 6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .a8-menu__tile:hover,
  .a8-menu__tile:focus {
    background: #142d54;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .a8-menu__tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .a8-menu__tile-number {
    font-size: 0.8rem;
    font-weight: 700;
    opacity: 0.75;
  }
  .a8-menu__tile-check {
    font-weight: 700;
    opacity: 0;
  }
  .a8-menu__tile[data-visited] .a8-menu__tile-check {
    opacity: 1;
  }
  .a8-menu__tile-title {
    font-weight: 700;
  }
  .a8-menu__tile-continue {
    margin-top: auto;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .a8-menu__tile[data-continue] {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .a8-menu__bonus {
    margin-top: var(--a8-space-lg);
    padding-top: var(--a8-space-md);
    border-top: 1px solid #ddd;
  }
  .a8-menu__bonus-heading {
    font-size: 1.1rem;
    margin-bottom: var(--a8-space-sm);
  }
  /* Lighter surface + accent border, not the solid navy of the core
     lifecycle tiles - signals "optional add-on", not "step N of 7". */
  .a8-menu__tile--bonus {
    background: var(--a8-surface);
    color: var(--a8-ink);
    border: 1px solid #ddd;
    border-top: 3px solid var(--a8-accent);
  }
  .a8-menu__tile--bonus:hover,
  .a8-menu__tile--bonus:focus {
    background: #f4f4f4;
    outline: 2px solid var(--a8-accent);
    outline-offset: 2px;
  }
  .a8-menu__tile--bonus .a8-menu__tile-top {
    justify-content: flex-end;
  }
  .a8-menu__tile--bonus[data-continue] {
    outline: 2px solid var(--a8-accent);
    outline-offset: 2px;
  }
</style>
