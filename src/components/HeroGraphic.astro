---
// Original vector artwork replacing the licensed landing-hero.jpg stock
// collage (person on a beanbag + satellite Earth photo) - the same image
// used, unmodified, in the sibling Data Ethics course, which needed
// removing there for copyright reasons; it needed removing here for the
// same reason. Drawn from scratch as inline SVG rather than sourced from
// any stock library - a neural-network motif (representing the AI system
// itself) orbited by icon badges for four of the six guiding principles
// this course's own Conclusion page names (Fairness, Transparency,
// Accountability, Privacy & Security), in the site's own icon style (flat
// circular badges, simple line icons) and its real accent colour.
---

<svg
  class="a8-hero-graphic"
  viewBox="0 0 500 350"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id="hero-grid" width="25" height="25" patternUnits="userSpaceOnUse">
      <path d="M 25 0 L 0 0 0 25" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.05" />
    </pattern>
    <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--a8-accent)" stop-opacity="0.35" />
      <stop offset="100%" stop-color="var(--a8-accent)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect x="0" y="0" width="500" height="350" fill="url(#hero-grid)" />

  <!-- orbit path -->
  <ellipse
    cx="330" cy="170" rx="155" ry="75"
    fill="none" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"
    stroke-dasharray="3 5"
    transform="rotate(-8 330 170)"
  />

  <!-- neural network (the AI system) -->
  <circle cx="330" cy="170" r="128" fill="url(#hero-glow)" />
  <circle cx="330" cy="170" r="110" fill="none" stroke="var(--a8-accent)" stroke-opacity="0.25" stroke-width="1.5" />
  <g stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.3">
    <line x1="330" y1="170" x2="260" y2="120" />
    <line x1="330" y1="170" x2="370" y2="95" />
    <line x1="330" y1="170" x2="390" y2="210" />
    <line x1="330" y1="170" x2="285" y2="230" />
    <line x1="260" y1="120" x2="310" y2="85" />
    <line x1="310" y1="85" x2="370" y2="95" />
    <line x1="370" y1="95" x2="405" y2="150" />
    <line x1="405" y1="150" x2="390" y2="210" />
    <line x1="390" y1="210" x2="340" y2="245" />
    <line x1="340" y1="245" x2="285" y2="230" />
    <line x1="285" y1="230" x2="250" y2="180" />
    <line x1="250" y1="180" x2="260" y2="120" />
  </g>
  <g fill="var(--a8-accent)">
    <circle cx="330" cy="170" r="5.5" />
    <circle cx="370" cy="95" r="3.5" />
    <circle cx="390" cy="210" r="3.5" />
  </g>
  <g fill="#ffffff">
    <circle cx="260" cy="120" r="3.5" />
    <circle cx="310" cy="85" r="3.5" />
    <circle cx="405" cy="150" r="3.5" />
    <circle cx="340" cy="245" r="3.5" />
    <circle cx="285" cy="230" r="3.5" />
    <circle cx="250" cy="180" r="3.5" />
  </g>

  <!-- sparkle accents -->
  <g fill="var(--a8-accent)">
    <path d="M250,28 Q256,34 262,40 Q256,46 250,52 Q244,46 238,40 Q244,34 250,28 Z" />
    <path d="M92,162 Q96,166 100,170 Q96,174 92,178 Q88,174 84,170 Q88,166 92,162 Z" />
    <path d="M402,222 Q407,227 412,232 Q407,237 402,242 Q397,237 392,232 Q397,227 402,222 Z" />
  </g>

  <!-- corner accent lines -->
  <g stroke="var(--a8-accent)" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round">
    <line x1="428" y1="332" x2="470" y2="304" />
    <line x1="448" y1="346" x2="490" y2="322" />
  </g>

  <!-- badge: transparency -->
  <g transform="translate(430 70)">
    <circle r="32" fill="#2a2a2a" stroke="var(--a8-accent)" stroke-width="2" />
    <path
      d="M-13,0 Q-6,-9 0,-9 Q6,-9 13,0 Q6,9 0,9 Q-6,9 -13,0 Z"
      fill="none" stroke="#ffffff" stroke-width="1.6"
    />
    <circle cx="0" cy="0" r="3.8" fill="#ffffff" />
  </g>

  <!-- badge: accountability -->
  <g transform="translate(150 80)">
    <circle r="36" fill="#2a2a2a" stroke="var(--a8-accent)" stroke-width="2" />
    <path
      d="M0,-15 L11,-10 L11,2 C11,10 6,14 0,17 C-6,14 -11,10 -11,2 L-11,-10 Z"
      fill="none" stroke="#ffffff" stroke-width="1.7" stroke-linejoin="round"
    />
    <path d="M-5,0 L-1,5 L7,-6" fill="none" stroke="#ffffff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </g>

  <!-- badge: fairness -->
  <g transform="translate(120 250)">
    <circle r="36" fill="var(--a8-surface)" stroke="#ddd" stroke-width="1" />
    <g stroke="var(--a8-ink)" stroke-width="1.7" stroke-linecap="round" fill="none">
      <line x1="-15" y1="-11" x2="15" y2="-11" />
      <line x1="0" y1="-11" x2="0" y2="13" />
      <line x1="-9" y1="13" x2="9" y2="13" />
      <path d="M-15,-11 L-19,-1 A4.5,3.5 0 0 0 -11,-1 Z" />
      <path d="M15,-11 L19,-1 A4.5,3.5 0 0 1 11,-1 Z" />
    </g>
  </g>

  <!-- badge: privacy & security -->
  <g transform="translate(330 292)">
    <circle r="34" fill="var(--a8-accent)" />
    <path d="M-6,-3 V-7 A6,6 0 0 1 6,-7 V-3" fill="none" stroke="#ffffff" stroke-width="1.7" />
    <rect x="-9" y="-3" width="18" height="15" rx="2.5" fill="none" stroke="#ffffff" stroke-width="1.7" />
    <circle cx="0" cy="4" r="1.6" fill="#ffffff" />
    <line x1="0" y1="5.5" x2="0" y2="8.5" stroke="#ffffff" stroke-width="1.7" stroke-linecap="round" />
  </g>
</svg>

<style>
  .a8-hero-graphic {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
