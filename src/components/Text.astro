---
// Recreates Adapt's "text" component type - a plain narrative text block.
interface Props {
  title?: string;
  body: string;
}

const { title, body } = Astro.props;
---

<section class="a8-text">
  {title && <h2>{title}</h2>}
  <div class="a8-prose" set:html={body} />
</section>

<style>
  .a8-text {
    margin-bottom: var(--a8-space-lg);
  }
  .a8-prose :global(ul) {
    padding-left: 1.25rem;
  }
  .a8-prose :global(a.customlink) {
    color: var(--a8-accent);
  }
  .a8-prose :global(table) {
    border-collapse: collapse;
    margin: var(--a8-space-md) 0;
  }
  .a8-prose :global(th),
  .a8-prose :global(td) {
    border: 1px solid var(--a8-rule);
    padding: 0.4rem 0.9rem;
    text-align: left;
  }
  .a8-prose :global(th) {
    background: var(--a8-surface);
  }
</style>
